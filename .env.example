# Copy to .env and adjust. Never commit .env.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
# Any long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
AIRFLOW_JWT_SECRET=change-me
# Host ports (change if already in use)
PM25_DB_PORT=5433
AIRFLOW_PORT=8080
DASHBOARD_PORT=8050
